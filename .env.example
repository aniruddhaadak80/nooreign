# Nooreign — environment template
#
# Copy to `.env.local` for local development: `cp .env.example .env.local`.
# `.env*` files are git-ignored; this template is committed and holds NO secrets.
#
# Every value below is a safe default or empty. Empty secret slots are filled at
# runtime from your own environment (or the CI secret store) — never paste a real
# key here, not even a test key.

# --- Next.js / runtime -------------------------------------------------------
# NODE_ENV=development
# NODE_ENV=production
NODE_ENV=development

# Canonical origin of the deployed site. Used for metadata, canonical URLs and
# the sitemap. Safe default: the production URL.
NEXT_PUBLIC_SITE_URL=https://nooreign.dev

# --- Agents service (services/agents, FastAPI) -------------------------------
# Server-side URL the Next app calls for deliberation enrichment. Left EMPTY by
# default: the atlas is fully functional without this service — it only adds
# optional live deliberation commentary. In docker-compose this is set to
# http://agents:8080.
# NOOREIGN_SERVICE_URL=http://localhost:8080
NOOREIGN_SERVICE_URL=

# Browser-visible URL for the agents service, if any. Only needed when the
# service is CORS-exposed to the client. Empty by default.
# NEXT_PUBLIC_NOOREIGN_SERVICE_URL=http://localhost:8080
NEXT_PUBLIC_NOOREIGN_SERVICE_URL=

# Port the Python agents service binds to.
PYTHON_PORT=8080

# Interface the agents service binds to. 0.0.0.0 inside a container; 127.0.0.1
# is safer on a bare host.
AGENTS_HOST=127.0.0.1
AGENTS_PORT=8080

# --- Logging ----------------------------------------------------------------
# Rust log filter for crates/engine. App/framework logs ignore this.
# RUST_LOG=info
RUST_LOG=info

# --- CI / tooling -----------------------------------------------------------
# Set to true in CI so the app can disable dev-only affordances.
CI=false

# Vercel deployment inputs. Fill from your Vercel project settings; leave EMPTY
# unless you are deploying. Supplied in CI from GitHub secrets, never committed.
# VERCEL_ORG_ID=team_XXXXXXXX
VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=prj_XXXXXXXX
VERCEL_PROJECT_ID=
# VERCEL_TOKEN=  # a Vercel personal access token
VERCEL_TOKEN=

# GitHub token used by release automation (creating releases / pushing tags).
# Supplied from GitHub secrets in CI; never committed.
# GITHUB_TOKEN=
GITHUB_TOKEN=