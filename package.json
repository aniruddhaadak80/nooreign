{
    "name":  "nooreign",
    "version":  "0.1.0",
    "private":  true,
    "description":  "The philosophical atlas of aligning intelligence",
    "license":  "MIT",
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev":  "turbo dev",
                    "build":  "turbo build",
                    "start":  "turbo start",
                    "lint":  "turbo lint",
                    "typecheck":  "turbo typecheck",
                    "test":  "turbo test",
                    "test:watch":  "vitest --watch",
                    "test:e2e":  "playwright test",
                    "e2e:install":  "playwright install chromium",
                    "assets":  "bun scripts/gen-assets.mjs",
                    "diagrams":  "bun scripts/gen-diagrams.mjs",
                    "generate":  "bun scripts/generate.ts",
                    "seed":  "bun scripts/seed.ts",
                    "loc":  "bun scripts/loc-count.mjs",
                    "verify":  "bun run typecheck \u0026\u0026 bun run lint \u0026\u0026 bun run test \u0026\u0026 bun run build",
                    "parity:generate":  "cargo run --quiet --manifest-path crates/engine/Cargo.toml --bin fixtures",
                    "parity:test":  "vitest run --project core src/parity.test.ts",
                    "verify:parity":  "bun run parity:generate \u0026\u0026 bun run parity:test",
                    "service:agents":  "python -m uvicorn services.agents.app.main:app --reload --port 8080",
                    "crate:engine":  "cargo test --manifest-path crates/engine/Cargo.toml"
                },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.13.0",
                            "@playwright/test":  "^1.64.1",
                            "@types/d3-scale":  "^4.0.9",
                            "@types/node":  "^26.6.5",
                            "eslint":  "^9.17.0",
                            "next":  "^15.5.27",
                            "prettier":  "^3.4.0",
                            "turbo":  "^2.3.0",
                            "typescript":  "^7.0.2",
                            "vitest":  "^5.0.5"
                        },
    "packageManager":  "bun@1.3.14",
    "engines":  {
                    "node":  "\u003e=20.11.0"
                }
}
