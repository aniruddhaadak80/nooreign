  DILEMMA }o--o{ DILEMMA_TAG : "tags[]"
  DILEMMA //--o{ REFERENCE : "references[]"

  DILEMMA //--o{ EXPERIMENT : "eraId anchors the case"

  TECHNIQUE }o--o{ TECHNIQUE : "requires[] / supersedes[]"
