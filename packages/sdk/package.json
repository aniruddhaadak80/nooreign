{
  "name": "@repo/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed clients for the Nooreign web API and the Python deliberation service",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./openapi.json"
  },
  "scripts": {
